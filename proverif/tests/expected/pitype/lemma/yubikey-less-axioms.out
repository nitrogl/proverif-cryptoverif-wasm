-- Axiom 
   event(VCell_bitstring(d_1,(i2,(x3,x_2,i1)))) && event(VCell_bitstring(d_1,(i2,(x1,x2,i3)))) ==> (x3,x_2,i1) = (x1,x2,i3)
   event(Counter(d_1,st1_1,st2,i1)) && event(Counter(d_1,st1_1,st2,i2)) ==> i2 = i1
   event(Counter(d_1,st1_1,st2,i1)) && event(Counter(d_1,st1_1,st3,i1)) ==> st2 = st3
 in process 1.
