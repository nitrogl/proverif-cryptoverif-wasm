Process 0 (that is, the initial process):
{1}!
{2}new k: bitstring;
{3}new pid: bitstring;
{4}new secretid: bitstring;
{5}new d_usr: channel;
{6}new d_srv: channel;
(
    {7}out(d_srv, (0,(secretid,k,0)))
) | (
    {8}out(d_usr, 1)
) | (
    {9}!
    {10}in(d_srv, x: bitstring);
    {11}out(d_srv, x)
) | (
    {12}!
    {13}in(d_usr, x_1: nat);
    {14}out(d_usr, x_1)
) | (
    {15}out(c, pid)
) | (
    {16}let d: channel = d_srv in
    {17}let pid_1: bitstring = pid in
    {18}let secretid_1: bitstring = secretid in
    {19}let k_1: bitstring = k in
    {20}!
    {21}in(c, (=pid_1,nonce: bitstring,otp: bitstring));
    {22}in(d, (i: nat,(=secretid_1,=k_1,otc: nat)));
    {23}event VCell_bitstring(d,(i,(secretid_1,k_1,otc)));
    {24}let (=secretid_1,tc: nat,npr: bitstring) = sdec(otp,k_1) in
    (
        {25}if (otc < tc) then
            {26}new st1[]: stamp;
            {27}event Counter(d,id1,st1,otc);
            {28}event Counter(d,id,st1,i);
            {29}event VCell_bitstring(d,(i + 1,(secretid_1,k_1,tc)));
            {30}event Login(pid_1,k_1,i + 1,tc);
            {31}out(d, (i + 1,(secretid_1,k_1,tc)))
        else
            {32}out(d, (i,(secretid_1,k_1,otc)))
    )
    else
        {33}out(d, (i,(secretid_1,k_1,otc)))
) | (
    {34}!
    {35}let cell: channel = d_usr in
    {36}let pid_2: bitstring = pid in
    {37}let secretid_2: bitstring = secretid in
    {38}let k_2: bitstring = k in
    {39}in(cell, tc_1: nat);
    {40}new st[]: stamp;
    {41}event Counter(cell,id,st,tc_1);
    {42}new nonce_1: bitstring;
    {43}new npr_1: bitstring;
    {44}event YubiPress(pid_2,secretid_2,k_2,tc_1);
    {45}out(c, (pid_2,nonce_1,senc((secretid_2,tc_1,npr_1),k_2)));
    {46}out(cell, tc_1 + 1)
)

