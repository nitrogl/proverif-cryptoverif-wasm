{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "rootDir": "src/node",
    "outDir": "node",
    "composite": true,
    "declaration": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "newLine": "lf",
    "tsBuildInfoFile": "../build/cryptoverif-node.tsbuildinfo"
  },
  "include": ["src/node/*.cts"]
}
