Proved forall mac2, tau: key_t, msgbeta, Am: bitstring, iRm <= N_Resp_R; event(accepted_cookie(Am, iRm, tau, msgbeta, mac2)) ==> event(generated_cookie(Am, iRm, tau)) in game 25
Adv[Game 1: forall mac2, tau: key_t, msgbeta, Am: bitstring, iRm <= N_Resp_R; event(accepted_cookie(Am, iRm, tau, msgbeta, mac2)) ==> event(generated_cookie(Am, iRm, tau))] <= #c_resp_4 * Pmac(time_2, 0, 1 + N_Resp_T, 0, maxlength(game 7: msgbeta)) + N_Resp_R * Pprf(time_1, N_Resp_T + N_Resp_C, max(maxlength(game 2: Am2'), maxlength(game 2: Am'))) + Adv[Game 25: forall mac2, tau: key_t, msgbeta, Am: bitstring, iRm <= N_Resp_R; event(accepted_cookie(Am, iRm, tau, msgbeta, mac2)) ==> event(generated_cookie(Am, iRm, tau))]
Adv[Game 25: forall mac2, tau: key_t, msgbeta, Am: bitstring, iRm <= N_Resp_R; event(accepted_cookie(Am, iRm, tau, msgbeta, mac2)) ==> event(generated_cookie(Am, iRm, tau))] <= 0
RESULT Proved forall mac2, tau: key_t, msgbeta, Am: bitstring, iRm <= N_Resp_R; event(accepted_cookie(Am, iRm, tau, msgbeta, mac2)) ==> event(generated_cookie(Am, iRm, tau)) up to probability #c_resp_4 * Pmac(time_2, 0, 1 + N_Resp_T, 0, maxlength(game 7: msgbeta)) + N_Resp_R * Pprf(time_1, N_Resp_T + N_Resp_C, max(maxlength(game 2: Am2'), maxlength(game 2: Am')))
RESULT time_1 = #c_resp_2 * time(([1,N_Resp_C], [1,N_Resp_R])) + #c_resp_4 * time(verify2f, maxlength(game 2: msgbeta)) + #c_resp_4 * time(([1,N_Resp_T], [1,N_Resp_R])) + time + (#c_resp_2 + #c_resp_4) * max(time(mac, max(maxlength(game 2: Am2'), maxlength(game 2: Am'))), (N_Resp_C + N_Resp_T) * time(= bitstring, max(maxlength(game 3: x_O_1), maxlength(game 3: x_O)), max(maxlength(game 3: x_O_1), maxlength(game 3: x_O))))
RESULT time_2 = #c_resp_2 * N_Resp_C * time(= bitstring, maxlength(game 7: Am'), maxlength(game 7: Am')) + #c_resp_2 * N_Resp_T * time(= bitstring, maxlength(game 7: Am'), maxlength(game 7: Am2')) + #c_resp_2 * time(([1,N_Resp_C], [1,N_Resp_R])) + #c_resp_4 * N_Resp_C * time(= bitstring, maxlength(game 7: Am2'), maxlength(game 7: Am')) + #c_resp_4 * N_Resp_T * time(= bitstring, maxlength(game 7: Am2'), maxlength(game 7: Am2')) + #c_resp_4 * time(([1,N_Resp_T], [1,N_Resp_R])) + time + 2 * #c_resp_4 * time(verify2f, maxlength(game 7: msgbeta))
