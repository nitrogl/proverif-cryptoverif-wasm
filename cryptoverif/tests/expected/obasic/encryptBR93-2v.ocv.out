       return(hash(hk_1, x1))
     ) | (
       foreach iH_1 <= qH2 do
       OH_1(x1_1: bitstring) :=
       return(hash2(hk2_1, x1_1))
     ) | (
       Ogen() :=
       r <-R keyseed;
       pk: pkey <- pkgen(r);
       sk: skey <- skgen(r);
       return(pk);
       ((
         foreach iD <= qD do
         OD(a: seed, b: hasht, c: hasht2) :=
         if defined(aT, bT, cT) && (a = aT) && (b = bT) && (c = cT) then
           yield
         else
           x_1: seed <- invf(sk, a);
           m: hasht <- xor(hash(hk_1, x_1), b);
           if c = hash2(hk2_1, concat(x_1, b)) then
           return(m)
       ) | (
         OT(m1: hasht, m2: hasht) :=
         b1 <-R bool;
         menc: hasht <- if_fun(b1, m1, m2);
         x_2 <-R seed;
         aT: seed <- f(pk, x_2);
         bT: hasht <- xor(hash(hk_1, x_2), menc);
         cT: hasht2 <- hash2(hk2_1, concat(x_2, bT));
         return(aT, bT, cT)
       ))
     ))


