Game 32 is
     start() :=
     rkA <-R keyseed;
     rkB <-R keyseed;
     return(pkgen2(rkA), pkgen2(rkB));
     ((
       foreach i <= NA do
       cA1(hostB: host) :=
       a_1 <-R Z;
       ga: G <- exp'(g, a_1);
       return(A, hostB, ga);
       cA3(=A, =hostB, gb_1: G, s_2: signature) :=
       find j2_4 = j2 <= NK suchthat defined(Kkey[j2], Rkey_1[j2], Khost[j2]) && (Khost[j2] = hostB) then
       (
         if Kkey[j2_4] = pkgen2(rkA) then
           yield
         else
           if Kkey[j2_4] = pkgen2(rkB) then
             yield
           else
             m_4: blocksize <- concatB(A, hostB, ga, gb_1);
             if check(m_4, Kkey[j2_4], s_2) then
             gab: G <- exp(gb_1, a_1);
             kA: D <- h(gab);
             m_2: blocksize <- concatA(A, hostB, ga, gb_1);
             r_4 <-R sign_seed;
             return(sign_r2(m_2, skgen2(rkA), r_4));
             cA5() :=
             return(kA)
       )
       orfind j2_4 = j2 <= NK suchthat defined(Rkey_2[j2], Khost[j2]) && (Khost[j2] = hostB) then
         yield
       orfind j2_4 = j2 <= NK suchthat defined(Rkey_3[j2], Khost[j2]) && (Khost[j2] = hostB) then
       (
         m_5: blocksize <- concatB(A, hostB, ga, gb_1);
         find u_21 = ri_21 <= NB suchthat defined(gb_2[ri_21], ga_1[ri_21], hostA[ri_21]) && (A = hostA[ri_21]) && (ga = ga_1[ri_21]) && (gb_1 = gb_2[ri_21]) && check2(m_5, pkgen2(rkB), s_2) then
         X <-R D;
         m_2: blocksize <- concatA(A, hostB, ga, gb_1);
         r_6 <-R sign_seed;
         return(sign_r2(m_2, skgen2(rkA), r_6));
         cA5() :=
         keyA: D <- X
       )
     ) | (
       foreach i_1 <= NB do
       cB1(hostA: host, =B, ga_1: G) :=
       b_1 <-R Z;
       gb_2: G <- exp'(g, b_1);
       m_3: blocksize <- concatB(hostA, B, ga_1, gb_2);
       r_3 <-R sign_seed;
       return(hostA, B, gb_2, sign_r2(m_3, skgen2(rkB), r_3));
       cB3(s_3: signature) :=
       find j2_5 = j2_2 <= NK suchthat defined(Kkey[j2_2], Rkey_1[j2_2], Khost[j2_2]) && (Khost[j2_2] = hostA) then
       (
         if Kkey[j2_5] = pkgen2(rkA) then
           yield
         else
           if Kkey[j2_5] = pkgen2(rkB) then
             yield
           else
             m_6: blocksize <- concatA(hostA, B, ga_1, gb_2);
             if check(m_6, Kkey[j2_5], s_3) then
             gab_1: G <- exp(ga_1, b_1);
             kB: D <- h(gab_1);
             return(kB)
       )
       orfind j2_5 = j2_2 <= NK suchthat defined(Rkey_2[j2_2], Khost[j2_2]) && (Khost[j2_2] = hostA) then
       (
         m1_1: blocksize <- concatA(hostA, B, ga_1, gb_2);
         find u_3 = ri_3 <= NA suchthat defined(X[ri_3], u_21[ri_3]) && (i_1 = u_21[ri_3]) && check2(m1_1, pkgen2(rkA), s_3) then
         keyB: D <- X[u_3]
       )
       orfind j2_5 = j2_2 <= NK suchthat defined(Rkey_3[j2_2], Khost[j2_2]) && (Khost[j2_2] = hostA) then
         yield
     ) | (
       foreach i_2 <= NK do
       cK(Khost: host, Kkey: pkey) :=
       if Khost = B then
         Rkey_3: pkey <- cst_pkey
       else
         if Khost = A then
           Rkey_2: pkey <- cst_pkey
         else
           Rkey_1: pkey <- cst_pkey
     ))


