Game 2 is
      cStart() :=
      hk_1 <-R hashkey;
      psk_1 <-R key;
      return();
      ((
        foreach ic <= Nc do
        cC0() :=
        x <-R Z;
        X: G <- exp(g, x);
        return(X);
        cC2(Y': G, k_s_1: key) :=
        v_5: three_keys <- H(hk_1, exp(Y', x), X, Y', psk_1);
        k': key <- 3-proj-tuple3keys(v_5);
        k_s': key <- 2-proj-tuple3keys(v_5);
        k_c'_1: key <- 1-proj-tuple3keys(v_5);
        if k_s_1 = k_s' then
        if defined(corruptedPSK) then
          return(k_c'_1)
        else
          k_secret_c: key <- k';
          return(k_c'_1)
      ) | (
        foreach is <= Ns do
        cS1(X': G) :=
        y <-R Z;
        Y: G <- exp(g, y);
