     cStart() :=
     hk_1 <-R hashkey;
     psk_1 <-R key;
     return();
     ((
       foreach ic <= Nc do
       cC0() :=
       x <-R Z;
       X: G <- exp(g, x);
       return(X);
       cC2(Y': G, k_s_1: key) :=
       v_5: three_keys <- H(hk_1, exp(Y', x), X, Y', psk_1);
       k_s': key <- 2-proj-tuple3keys(v_5);
       if k_s_1 = k_s' then
       k_c'_1: key <- 1-proj-tuple3keys(v_5);
       if defined(corruptedPSK) then
         return(k_c'_1)
       else
         k': key <- 3-proj-tuple3keys(v_5);
         find j3 = j3_1 <= Ns suchthat defined(X'[j3_1], Y[j3_1]) && (X = X'[j3_1]) && (Y' = Y[j3_1]) then
           k_secret_c: key <- k';
           return(k_c'_1)
         else
           event_abort client_break_auth
     ) | (
       foreach is <= Ns do
       cS1(X': G) :=
       y <-R Z;
       Y: G <- exp(g, y);
       v_4: three_keys <- H(hk_1, exp(X', y), X', Y, psk_1);
       k_s_2: key <- 2-proj-tuple3keys(v_4);
       k_c: key <- 1-proj-tuple3keys(v_4);
       return(Y, k_s_2);
       cS3(k_c'_2: key) :=
       if k_c = k_c'_2 then
       if defined(corruptedPSK) then
         yield
       else
         k: key <- 3-proj-tuple3keys(v_4);
         find j4 = j4_1 <= Nc suchthat defined(X[j4_1]) && (X' = X[j4_1]) then
           k_secret_s: key <- k
         else
           event_abort server_break_auth
     ) | (
       cCorrupt() :=
       corruptedPSK: bool <- cst_bool;
       return(psk_1)
     ) | (
       foreach iH <= qH do
       ch1(x1: G, x2: G, x3: G, x4: key) :=
       return(H(hk_1, x1, x2, x3, x4))
     ))

