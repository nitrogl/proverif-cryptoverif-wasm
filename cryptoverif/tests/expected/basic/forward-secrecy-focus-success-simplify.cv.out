Game 1 is
      cStart() :=
      hk_1 <-R hashkey;
      psk_1 <-R key;
      return();
      ((
        foreach ic <= Nc do
        cC0() :=
        x <-R Z;
        X: G <- exp(g, x);
        return(X);
        cC2(Y': G, k_s_1: key) :=
  {20}  let tuple3keys(k_c'_1: key, k_s': key, k': key) = H(hk_1, exp(Y', x), X, Y', psk_1) in
        if k_s_1 = k_s' then
        if defined(corruptedPSK) then
          return(k_c'_1)
        else
          k_secret_c: key <- k';
          return(k_c'_1)
      ) | (
        foreach is <= Ns do
        cS1(X': G) :=
        y <-R Z;
        Y: G <- exp(g, y);
  {64}  let tuple3keys(k_c: key, k_s_2: key, k: key) = H(hk_1, exp(X', y), X', Y, psk_1) in
        return(Y, k_s_2);
        cS3(k_c'_2: key) :=
        if k_c = k_c'_2 then
        if defined(corruptedPSK) then
          yield
        else
          k_secret_s: key <- k
      ) | (
        cCorrupt() :=
        corruptedPSK: bool <- true;
        return(psk_1)
      ) | (
        foreach iH <= qH do
        ch1(x1: G, x2: G, x3: G, x4: key) :=
        return(H(hk_1, x1, x2, x3, x4))
      ))


