     pkB: pkey <- pkgen(rkB);
     return(pkA, pkB);
     ((
       foreach i <= NA do
       cA1(hostB: host) :=
       a <-R Z;
       ga: G <- exp(g, a);
       return(A, hostB, ga);
       cA3(=A, =hostB, gb_1: G, s_2: signature) :=
       find j2_4 = j2 <= NK suchthat defined(Khost[j2], Rkey[j2]) && (Khost[j2] = hostB) then
       pkhostB: pkey <- Rkey[j2_4];
       if check(concatB(A, hostB, ga, gb_1), pkhostB, s_2) then
       gab: G <- exp(gb_1, a);
       kA: D <- h(gab);
       event endA(A, hostB, ga, gb_1);
       return((m_2: blocksize <- concatA(A, hostB, ga, gb_1); r_2 <-R sign_seed; sign_r(m_2, skA, r_2)));
       cA5() :=
       if hostB = B then
         keyA: D <- kA
       else
         return(kA)
     ) | (
       foreach i_1 <= NB do
       cB1(hostA: host, =B, ga_1: G) :=
       b <-R Z;
       gb_2: G <- exp(g, b);
       event beginB(hostA, B, ga_1, gb_2);
       return(hostA, B, gb_2, (m_3: blocksize <- concatB(hostA, B, ga_1, gb_2); r_3 <-R sign_seed; sign_r(m_3, skB, r_3)));
       cB3(s_3: signature) :=
       find j2_5 = j2_2 <= NK suchthat defined(Khost[j2_2], Rkey[j2_2]) && (Khost[j2_2] = hostA) then
       pkhostA: pkey <- Rkey[j2_5];
       if check(concatA(hostA, B, ga_1, gb_2), pkhostA, s_3) then
       gab_1: G <- exp(ga_1, b);
       kB: D <- h(gab_1);
       event endB(hostA, B, ga_1, gb_2);
       if hostA = A then
         keyB: D <- kB
       else
         return(kB)
     ) | (
       foreach i_2 <= NK do
       cK(Khost: host, Kkey: pkey) :=
