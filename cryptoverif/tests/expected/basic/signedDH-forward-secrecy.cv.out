        event beginB(hostA, B, Bga, Bgb);
        m_3: blocksize <- concatB(hostA, B, Bga, Bgb);
        r_3 <-R sign_seed;
        return(hostA, B, Bgb, sign_r(m_3, skB, r_3));
        cB3(s_3: signature) :=
