Game 1 is
      start() :=
      hk_1 <-R hashkey;
      rkA <-R keyseed;
      skA: skey <- skgen(rkA);
      pkA: pkey <- pkgen(rkA);
      rkB <-R keyseed;
      skB: skey <- skgen(rkB);
      pkB: pkey <- pkgen(rkB);
      return(pkA, pkB);
      ((
        foreach i <= NA do
        cA1(hostB: host) :=
        a <-R Z;
        Aga: G <- exp(g, a);
        return(A, hostB, Aga);
        cA3(=A, =hostB, Agb: G, s_2: signature) :=
        find j2_4 = j2 <= NK suchthat defined(Khost[j2], Rkey[j2]) && (Khost[j2] = hostB) then
        pkhostB: pkey <- Rkey[j2_4];
        if check(concatB(A, hostB, Aga, Agb), pkhostB, s_2) then
        sA: signature <- (m_2: blocksize <- concatA(A, hostB, Aga, Agb); r_2 <-R sign_seed; sign_r(m_2, skA, r_2));
        gab: G <- exp(Agb, a);
        kA: D <- h(hk_1, gab);
        event endA(A, hostB, Aga, Agb, kA);
        return(sA);
        cA5() :=
        if hostB = B then
          if defined(Acorrupted) then
            return(kA)
          else
            if defined(Bcorrupted) then
              return(kA)
            else
              kA_secret: D <- kA
        else
          return(kA)
      ) | (
        foreach i_1 <= NB do
        cB1(hostA: host, =B, Bga: G) :=
        b <-R Z;
        Bgb: G <- exp(g, b);
        event beginB(hostA, B, Bga, Bgb);
        return(hostA, B, Bgb, (m_3: blocksize <- concatB(hostA, B, Bga, Bgb); r_3 <-R sign_seed; sign_r(m_3, skB, r_3)));
        cB3(s_3: signature) :=
        find j2_5 = j2_2 <= NK suchthat defined(Khost[j2_2], Rkey[j2_2]) && (Khost[j2_2] = hostA) then
        pkhostA: pkey <- Rkey[j2_5];
        if check(concatA(hostA, B, Bga, Bgb), pkhostA, s_3) then
        gab_1: G <- exp(Bga, b);
        kB: D <- h(hk_1, gab_1);
        event endB(hostA, B, Bga, Bgb, kB);
        if hostA = A then
          find j_1 = j <= NA suchthat defined(hostB[j], Aga[j], Agb[j], kA[j]) && (hostB[j] = B) && (Aga[j] = Bga) && (Agb[j] = Bgb) then
            yield
          else
            return(kB)
        else
          return(kB)
      ) | (
        foreach iH <= qH do
        ch1(x1: G) :=
        return(h(hk_1, x1))
      ) | (
        foreach i_2 <= NK do
        cK(Khost: host, Kkey: pkey) :=
        Rkey: pkey <- (if Khost = B then pkB else if Khost = A then pkA else Kkey)
      ) | (
        cCorruptA() :=
        Acorrupted: bool <- true;
        event evAcorrupted;
        return(skA)
      ) | (
        cCorruptB() :=
        Bcorrupted: bool <- true;
        event evBcorrupted;
        return(skB)
      ))


