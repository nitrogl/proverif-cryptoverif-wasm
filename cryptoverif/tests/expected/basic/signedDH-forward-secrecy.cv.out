        foreach i_2 <= NK do
        cK(Khost: host, Kkey: pkey) :=
        if Khost = B then
          Rkey: pkey <- pkB
        else
          if Khost = A then
            Rkey: pkey <- pkA
          else
            Rkey: pkey <- Kkey
      ) | (
        cCorruptA() :=
        Acorrupted: bool <- true;
        event evAcorrupted;
        return(skA)
      ) | (
        cCorruptB() :=
        Bcorrupted: bool <- true;
