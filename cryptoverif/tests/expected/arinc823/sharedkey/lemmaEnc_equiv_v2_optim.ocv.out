Game 28 is
     Ogen() :=
     k_3 <-R enc_key;
     IV0_1: blocksize <- AES(k_3, Zero);
     return();
     ((
       Oenc1(IVdata1_1: blocksize, m1_1: blocksize, l_5: len) :=
       if defined(IVdata2_1) && (IVdata1_1 = IVdata2_1) then
         event_abort repeatedIV
       else
         if defined(IVdata3_1) && (IVdata1_1 = IVdata3_1) then
           event_abort repeatedIV
         else
           IV1_1: blocksize <- xor(IV0_1, IVdata1_1);
           c1_1: blocksize <- {26}xor(AES(k_3, IV1_1), Zero);
           return(truncate(c1_1, l_5))
     ) | (
       Oenc2(IVdata2_1: blocksize, m21_1: blocksize, m22_1: blocksize, l_6: len) :=
       if defined(IVdata1_1) && (IVdata2_1 = IVdata1_1) then
         event_abort repeatedIV
       else
         if defined(IVdata3_1) && (IVdata2_1 = IVdata3_1) then
           event_abort repeatedIV
         else
           IV2_1: blocksize <- xor(IV0_1, IVdata2_1);
           c21_1: blocksize <- {54}xor(AES(k_3, IV2_1), Zero);
           c22_1: blocksize <- {60}xor(AES(k_3, c21_1), Zero);
           return(c21_1, truncate(c22_1, l_6))
     ) | (
       Oenc3(IVdata3_1: blocksize, m31_1: blocksize, m32_1: blocksize, m33_1: blocksize, l_7: len) :=
       if defined(IVdata1_1) && (IVdata3_1 = IVdata1_1) then
         event_abort repeatedIV
