     Ogen() :=
     k_4 <-R enc_key;
     IV0: blocksize <- (x_O_enc: blocksize <- Zero; {6}find [unique]  else {7}find  else r_enc <-R blocksize; r_enc);
     return();
     ((
       Oenc1(IVdata1: blocksize, m1: blocksize, l_1: len) :=
       if defined(IVdata2) && (IVdata1 = IVdata2) then
         event_abort repeatedIV
