Game 6 is
      Ogen() :=
      x_O: blocksize <- Zero;
      r <-R blocksize;
      return();
      ((
        Oenc1(IVdata1: blocksize, m1: blocksize, l_1: len) :=
        if defined(IVdata2) && (IVdata1 = IVdata2) then
          event_abort repeatedIV
        else
          if defined(IVdata3) && (IVdata1 = IVdata3) then
            event_abort repeatedIV
          else
            IV1: blocksize <- xor(r, IVdata1);
            find [unique]  suchthat r = IVdata1 then
              c1: blocksize <- xor(r, m1);
              return(truncate(c1, l_1))
            orfind  suchthat defined(x_O_3, r_3) && (IV1 = x_O_3) then
              c1: blocksize <- xor(r_3, m1);
              return(truncate(c1, l_1))
            orfind  suchthat defined(x_O_5, r_5) && (IV1 = x_O_5) then
              c1: blocksize <- xor(r_5, m1);
              return(truncate(c1, l_1))
            orfind  suchthat defined(x_O_6, r_6) && (IV1 = x_O_6) then
              c1: blocksize <- xor(r_6, m1);
              return(truncate(c1, l_1))
            else
              r_1 <-R blocksize;
              c1: blocksize <- xor(r_1, m1);
              return(truncate(c1, l_1))
      ) | (
        Oenc2(IVdata2: blocksize, m21: blocksize, m22: blocksize, l_2: len) :=
