Initial state
Game 1 is
      Ogen() :=
      k_1 <-R enc_key;
      IV0: blocksize <- AES(k_1, Zero);
      return();
      ((
        Oenc1(IVdata1: blocksize, m1: blocksize, l_1: len) :=
        if defined(IVdata2) && (IVdata1 = IVdata2) then
          event_abort repeatedIV
        else
          if defined(IVdata3) && (IVdata1 = IVdata3) then
            event_abort repeatedIV
          else
            IV1: blocksize <- xor(IV0, IVdata1);
            c1: blocksize <- xor(AES(k_1, IV1), m1);
            return(truncate(c1, l_1))
      ) | (
        Oenc2(IVdata2: blocksize, m21: blocksize, m22: blocksize, l_2: len) :=
        if defined(IVdata1) && (IVdata2 = IVdata1) then
          event_abort repeatedIV
        else
          if defined(IVdata3) && (IVdata2 = IVdata3) then
            event_abort repeatedIV
          else
            IV2: blocksize <- xor(IV0, IVdata2);
            c21: blocksize <- xor(AES(k_1, IV2), m21);
            c22: blocksize <- xor(AES(k_1, c21), m22);
            return(c21, truncate(c22, l_2))
      ) | (
        Oenc3(IVdata3: blocksize, m31: blocksize, m32: blocksize, m33: blocksize, l_3: len) :=
        if defined(IVdata1) && (IVdata3 = IVdata1) then
          event_abort repeatedIV
        else
          if defined(IVdata2) && (IVdata3 = IVdata2) then
            event_abort repeatedIV
          else
            IV3: blocksize <- xor(IV0, IVdata3);
            c31: blocksize <- xor(AES(k_1, IV3), m31);
            c32: blocksize <- xor(AES(k_1, c31), m32);
            c33: blocksize <- xor(AES(k_1, c32), m33);
            return(c31, c32, truncate(c33, l_3))
      ))


Applying equivalence prf(AES) [probability P_AES(time_1, 7)]
  - Equivalence prf(AES) with variables: k_1 -> k_4
yields

Game 2 is
      Ogen() :=
      IV0: blocksize <- (x_O: blocksize <- Zero; {5}find [unique]  else r <-R blocksize; r);
      return();
      ((
        Oenc1(IVdata1: blocksize, m1: blocksize, l_1: len) :=
        if defined(IVdata2) && (IVdata1 = IVdata2) then
          event_abort repeatedIV
        else
          if defined(IVdata3) && (IVdata1 = IVdata3) then
            event_abort repeatedIV
          else
            IV1: blocksize <- xor(IV0, IVdata1);
            c1: blocksize <- xor((x_O_1: blocksize <- IV1; find [unique]  suchthat defined(x_O, r) && (x_O_1 = x_O) then r orfind  suchthat defined(x_O_2, r_2) && (x_O_1 = x_O_2) then r_2 orfind  suchthat defined(x_O_3, r_3) && (x_O_1 = x_O_3) then r_3 orfind  suchthat defined(x_O_4, r_4) && (x_O_1 = x_O_4) then r_4 orfind  suchthat defined(x_O_5, r_5) && (x_O_1 = x_O_5) then r_5 orfind  suchthat defined(x_O_6, r_6) && (x_O_1 = x_O_6) then r_6 else r_1 <-R blocksize; r_1), m1);
            return(truncate(c1, l_1))
      ) | (
        Oenc2(IVdata2: blocksize, m21: blocksize, m22: blocksize, l_2: len) :=
        if defined(IVdata1) && (IVdata2 = IVdata1) then
          event_abort repeatedIV
        else
          if defined(IVdata3) && (IVdata2 = IVdata3) then
            event_abort repeatedIV
          else
            IV2: blocksize <- xor(IV0, IVdata2);
            c21: blocksize <- xor((x_O_2: blocksize <- IV2; find [unique]  suchthat defined(x_O, r) && (x_O_2 = x_O) then r orfind  suchthat defined(x_O_1, r_1) && (x_O_2 = x_O_1) then r_1 orfind  suchthat defined(x_O_4, r_4) && (x_O_2 = x_O_4) then r_4 orfind  suchthat defined(x_O_5, r_5) && (x_O_2 = x_O_5) then r_5 orfind  suchthat defined(x_O_6, r_6) && (x_O_2 = x_O_6) then r_6 else r_2 <-R blocksize; r_2), m21);
            c22: blocksize <- xor((x_O_3: blocksize <- c21; find [unique]  suchthat defined(x_O, r) && (x_O_3 = x_O) then r orfind  suchthat defined(x_O_1, r_1) && (x_O_3 = x_O_1) then r_1 orfind  suchthat defined(x_O_2, r_2) && (x_O_3 = x_O_2) then r_2 orfind  suchthat defined(x_O_4, r_4) && (x_O_3 = x_O_4) then r_4 orfind  suchthat defined(x_O_5, r_5) && (x_O_3 = x_O_5) then r_5 orfind  suchthat defined(x_O_6, r_6) && (x_O_3 = x_O_6) then r_6 else r_3 <-R blocksize; r_3), m22);
            return(c21, truncate(c22, l_2))
      ) | (
        Oenc3(IVdata3: blocksize, m31: blocksize, m32: blocksize, m33: blocksize, l_3: len) :=
        if defined(IVdata1) && (IVdata3 = IVdata1) then
          event_abort repeatedIV
        else
          if defined(IVdata2) && (IVdata3 = IVdata2) then
            event_abort repeatedIV
          else
